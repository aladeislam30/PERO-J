{
  "name": "peroj-oracle-adapters",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit:bonds": "tsx scripts/audit-bonds.ts",
    "start": "node src/daemon.js",
    "start:daemon": "tsx src/daemon.js",
    "build": "tsc -p tsconfig.json",
    "healthcheck": "node -e \"fetch('http://127.0.0.1:'+(process.env.PORT||8081)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "pg": "8.12.0",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/pg": "8.11.10",
    "nock": "14.0.10",
    "typescript": "5.6.3"
  }
}
